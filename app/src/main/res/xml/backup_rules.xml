<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 e anteriores. A sessão (tokens) nunca vai para o backup. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <exclude domain="sharedpref" path="session.xml" />
    <include domain="database" path="." />
</full-backup-content>
